{
	"name": "__MSG_extensionName__",
	"version": "1.0.0",
	"manifest_version": 3,
	"default_locale":"ru", 
	"description": "__MSG_extensionDescription__",
	"icons": {
		"128": "images/btn_128.png",
		"48": "images/btn_48.png",
		"16": "images/btn_16.png"
	},
	"action": {
		"default_icon": "images/btn_48.png"
	},

	"background": {
   		"service_worker": "background.js"
	},

	"content_scripts": [ {
		"all_frames": false,
		"js": [ "tool_content.js" ],
		"css": [ "tool_wnd/tool.css" ],
		"matches": [ 
			"http://*/*", 
			"https://*/*" ],
		"run_at": "document_end"
	} ],
	"permissions": [
	    "contextMenus",
	    "scripting",
	    "activeTab"
	],
	"host_permissions": [
		"http://*/*", 
		"https://*/*"
	],
	
	"web_accessible_resources": [{
		"resources": [ 
			"tool_wnd/tool.html",
			"tool_wnd/tool.css"
		],
		"matches": [ 
			"http://*/*", 
			"https://*/*" ]
	}]
}